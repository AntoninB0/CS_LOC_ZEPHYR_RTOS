/* ── Initiator UARTs ────────────────────────────────────────────────────────
 * DK mapping (J-Link OB):
 *   uart20  P1.04/P1.05 -> VCOM (Serial Port 1): Zephyr console/logs
 *   uart30  P0.00/P0.01 -> VCOM (Serial Port 0): OUR data+commands channel
 *   uart21  P1.08/P1.09 -> extension header (NO VCOM): drone link
 * if.c selects uart30 (bench PC) or uart21 (drone-embedded) via
 * IF_UART_ON_VCOM in if.c. */

/* 1 Mbaud on the data channel: the continuous IQ dump (IQL/IQP) drops from
 * ~30-60 ms to ~4-7 ms per procedure. Both UARTs set to the same rate to cover
 * if.c's two targets (uart30 = bench-PC VCOM; uart21 = drone link). NB: at
 * 1 Mbaud the DK's J-Link OB may truncate depending on its firmware version;
 * if the IQ lines are corrupt on the VCOM, drop uart30 back to 921600. */
&uart30 {
    status = "okay";
    current-speed = <921600>;
};

&uart21 {
    status = "okay";
    current-speed = <1000000>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>, <NRF_PSEL(UART_RX, 1, 9)>;
        };
    };
};
