/* ── UARTs de l'initiateur ──────────────────────────────────────────────────
 * Mapping DK (J-Link OB) :
 *   uart20  P1.04/P1.05 → VCOM (Serial Port 1) : console/logs Zephyr
 *   uart30  P0.00/P0.01 → VCOM (Serial Port 0) : NOTRE canal data+commandes
 *   uart21  P1.08/P1.09 → header d'extension (AUCUN VCOM) : liaison drone
 * if.c choisit uart30 (banc PC) ou uart21 (embarqué drone) via
 * IF_UART_ON_VCOM dans if.c. */

&uart30 {
    status = "okay";
    current-speed = <115200>;
};

&uart21 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>, <NRF_PSEL(UART_RX, 1, 9)>;
        };
    };
};
